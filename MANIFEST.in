include README.md
include LICENSE
include pyproject.toml
include CITATION.cff

recursive-include cbfjax *.py
recursive-include cbfjax *.pyi
recursive-include cbfjax py.typed
recursive-include cbfjax/utils/map_editor *.html

# Exclude build/test/dev artifacts
recursive-exclude tests *
recursive-exclude examples *
recursive-exclude flowbarrier *

global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dylib
global-exclude *.egg-info
